{
  "name": "pi-laya",
  "version": "0.1.0",
  "private": true,
  "description": "Deployment-neutral System-One decision extension for Pi",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": ["dist/src", "README.md", "SECURITY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:pi-commands": "npm run build && node --test dist/tests/extension.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "privacy:check": "node dist/src/privacy-scan.js",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": ["./dist/src/index.js"]
  }
}
